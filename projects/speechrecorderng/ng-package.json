{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/speechrecorderng",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "glob": "theme.scss",
      "input": "src",
      "output": "."
    },
    {
      "glob": "**/*.scss",
      "input": "src/lib/theme",
      "output": "lib/theme"
    }
  ]
}
